# ==================== 后端配置 ====================
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret
APP_ADMIN_TOKEN=admin-dev-token

# ==================== 数据库 ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=translation
POSTGRES_USER=translation
POSTGRES_PASSWORD=change-me

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379

# ==================== MinIO ====================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=translation
MINIO_SECURE=false

# ==================== Qwen / DashScope ====================
# 阿里云 DashScope OpenAI 兼容端点
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-27b

# ==================== 翻译参数 ====================
# 全局并发上限（同时翻译文件数）
TRANSLATION_MAX_CONCURRENCY=4
# 单文件内段落级并发数（线程池），用于提升单文件翻译速度
# 取值建议 4-10，过高会触发 DashScope 限流（默认 6）
TRANSLATION_PARAGRAPH_CONCURRENCY=6
# 大文件分片调度阈值（字符数）
# 总字符数超过此值时按片顺序调度（片内仍并发），降低对 DashScope 配额的瞬时冲击
TRANSLATION_LARGE_FILE_THRESHOLD=30000
# 单分片最大字符数（建议 6000）
TRANSLATION_CHUNK_MAX_CHARS=6000
# 末分片合并下限（小于此值与前一片合并，避免碎片）
TRANSLATION_CHUNK_MIN_CHARS=1500
# 文件保留天数（0 表示永不过期，默认 180 天，管理员可在后台动态调整）
FILE_RETENTION_DAYS=180

# ==================== PaddleOCR 兼容性 ====================
# 关闭 oneDNN/MKL-DNN 推理加速，避免某些 CPU 上 PaddlePaddle 报
# "ConvertPirAttribute2RuntimeAttribute not support" 等不兼容错误。
# 关闭后纯 CPU 推理略慢，但能保证 OCR 在本地完成（不走 VL 模型外发）。
FLAGS_use_mkldnn=false
# 同时关闭 oneDNN 算子（Paddle 3.x 新参数名，双保险）
FLAGS_use_onednn=false
